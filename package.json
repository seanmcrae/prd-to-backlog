{
  "name": "prd-to-backlog",
  "version": "0.1.0",
  "description": "Turn a product requirements document into a traceable, linted backlog and export it to tracker formats.",
  "license": "MIT",
  "author": "Sean McRae",
  "homepage": "https://seanmcrae.github.io/prd-to-backlog/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanmcrae/prd-to-backlog.git"
  },
  "bugs": {
    "url": "https://github.com/seanmcrae/prd-to-backlog/issues"
  },
  "keywords": [
    "prd",
    "backlog",
    "user-stories",
    "acceptance-criteria",
    "jira",
    "linear",
    "product-management",
    "llm"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "prd2backlog": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "demo": "npm run build && sh scripts/demo.sh",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "site": "tsx scripts/site/build.ts",
    "chart": "tsx scripts/site/chart.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "commander": "^15.0.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "marked": "^18.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
